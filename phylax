#!/usr/bin/python3 -I
"""phylax: sweep this host and its containers for known vulnerabilities, then let an LLM triage them

Examples:
  phylax                   full sweep: inventory, scanners, LLM triage, saved report
  phylax --no-llm          scanners only, print the collected data (free, no network LLM)
  phylax --dry-run         print the prompt that would be sent, send nothing
  phylax -p glm            use another provider from the config for this run

The scanners do the finding (arch-audit for host packages, trivy for container images, the AUR and
GitHub for things neither covers). The LLM only reads their output and decides what matters here.
It gets WebFetch/WebSearch and nothing else: no Bash, no Read, so it can't touch any file.

Exit: 0 all clear, 3 something to act on, 1 failed (sema's scan module pings on 3).
Config: ~/.config/phylax/config.toml   Reports: ~/.local/state/phylax/
Standard library only.
"""

import argparse
import datetime
import json
import os
import re
import shutil
import subprocess
import sys
import tomllib
import urllib.parse
import urllib.request
from pathlib import Path

HERE = Path(os.path.realpath(__file__)).parent
CONFIG_PATH = Path(os.environ.get("PHYLAX_CONFIG", "~/.config/phylax/config.toml")).expanduser()
STATE = Path(os.environ.get("XDG_STATE_HOME", "~/.local/state")).expanduser() / "phylax"
UA = "phylax/1"

DEFAULTS = {
    "provider": "claude",
    "providers": {
        "claude": {"tools": ["WebFetch", "WebSearch"]},
    },
    "severity": ["HIGH", "CRITICAL"],
    "per_image_limit": 25,
    "key_packages": [],
    "context_files": [],
    "advisory_urls": {},
    "keep_reports": 30,
    "notify": "",
}


def log(*args):
    print("phylax:", *args, file=sys.stderr, flush=True)


def run(cmd, timeout=600, **kw):
    """Run a command, return (returncode, stdout, stderr). A missing binary is rc 127, never an exception."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, **kw)
        return p.returncode, p.stdout, p.stderr
    except FileNotFoundError:
        return 127, "", f"{cmd[0]}: not installed"
    except subprocess.TimeoutExpired:
        return 124, "", f"{cmd[0]}: timed out after {timeout}s"


def load_config():
    cfg = json.loads(json.dumps(DEFAULTS))
    if CONFIG_PATH.exists():
        with open(CONFIG_PATH, "rb") as f:
            user = tomllib.load(f)
        providers = user.pop("providers", {})
        cfg.update(user)
        for name, p in providers.items():
            cfg["providers"].setdefault(name, {}).update(p)
    else:
        log(f"no config at {CONFIG_PATH}, using defaults (run install.sh to create one)")
    return cfg


def get_json(url, timeout=20):
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


# --- host ------------------------------------------------------------------------------------------

def host_inventory(cfg):
    data = {}
    data["os"] = next((line.split("=", 1)[1].strip().strip('"') for line in open("/etc/os-release")
                       if line.startswith("PRETTY_NAME=")), "unknown")
    data["kernel"] = os.uname().release

    _, out, _ = run(["pacman", "-Q"])
    installed = dict(line.split()[:2] for line in out.splitlines() if line.strip())
    data["package_count"] = len(installed)
    data["key_packages"] = {n: installed.get(n, "not installed") for n in cfg["key_packages"]}
    kernels = {n: v for n, v in installed.items() if re.fullmatch(r"linux(-[\w]+)*", n) and "headers" not in n
               and "firmware" not in n and "api" not in n}
    data["kernel_packages"] = kernels

    _, out, _ = run(["pacman", "-Qm"])
    foreign = dict(line.split()[:2] for line in out.splitlines() if line.strip())
    data["foreign_packages"] = aur_compare(foreign)

    rc, out, err = run(["checkupdates"], timeout=180)
    # checkupdates: 0 = updates listed, 2 = none, other = error
    if rc == 0:
        data["pending_updates"] = out.splitlines()
    elif rc == 2:
        data["pending_updates"] = []
    else:
        data["pending_updates"] = f"checkupdates failed: {err.strip()[:200]}"

    rc, out, err = run(["angie", "-v"])  # prints to stderr
    data["angie"] = (out + err).strip() if rc == 0 else "not installed"
    data["angie_latest_tag"] = github_latest_tag("webserver-llc/angie")

    _, out, _ = run(["ss", "-tulnH"])
    listeners = set()
    for line in out.splitlines():
        parts = line.split()
        if len(parts) >= 5:
            listeners.add(f"{parts[0]} {parts[4]}")
    data["listening_sockets"] = sorted(listeners)
    return data


def aur_compare(foreign):
    """Installed version vs the AUR's, for packages arch-audit knows nothing about."""
    if not foreign:
        return {}
    result = {n: {"installed": v, "aur": None} for n, v in foreign.items()}
    try:
        qs = "&".join("arg[]=" + urllib.parse.quote(n) for n in foreign)
        for r in get_json("https://aur.archlinux.org/rpc/v5/info?" + qs)["results"]:
            entry = result[r["Name"]]
            entry["aur"] = r["Version"]
            _, cmp, _ = run(["vercmp", entry["installed"], r["Version"]])
            entry["outdated"] = cmp.strip().startswith("-")
    except Exception as e:
        log(f"AUR lookup failed: {e}")
    return result


def github_latest_tag(repo):
    try:
        return get_json(f"https://api.github.com/repos/{repo}/tags?per_page=1")[0]["name"]
    except Exception as e:
        return f"lookup failed: {e}"


def arch_audit():
    rc, out, err = run(["arch-audit", "-c"], timeout=180)
    if rc == 127:
        return "arch-audit is not installed (sudo pacman -S arch-audit)"
    if rc != 0 and not out:
        return f"arch-audit failed: {err.strip()[:300]}"
    return out.strip() or "no affected packages"


# --- containers ------------------------------------------------------------------------------------

def containers():
    """Running containers grouped by image. Only names and image refs, never env or inspect output."""
    rc, out, err = run(["podman", "ps", "--format", "json"])
    if rc != 0:
        return {}, f"podman ps failed: {err.strip()[:300]}"
    images = {}
    for c in json.loads(out or "[]"):
        img = images.setdefault(c["ImageID"], {"image": c["Image"], "containers": []})
        img["containers"] += c.get("Names", [])
    if images:
        _, out, _ = run(["podman", "image", "inspect", "--format", "{{.Id}} {{.Created}}", *images])
        for line in out.splitlines():
            iid, _, created = line.partition(" ")
            if iid in images:
                images[iid]["created"] = created[:10]
    return images, None


def trivy_scan(images, cfg):
    if not shutil.which("trivy"):
        return "trivy is not installed (sudo pacman -S trivy)"
    sev = ",".join(cfg["severity"])
    log("updating the trivy vulnerability database")
    rc, _, err = run(["trivy", "image", "--download-db-only", "--quiet"], timeout=900)
    if rc != 0:
        return f"trivy db update failed: {err.strip()[:300]}"

    results = {}
    for n, (iid, info) in enumerate(images.items(), 1):
        ref = info["image"]
        log(f"[{n}/{len(images)}] trivy {ref}")
        # --scanners vuln: no secret scanning, so nothing secret from an image can end up in the prompt
        rc, out, err = run(["trivy", "image", "--image-src", "podman", "--scanners", "vuln",
                            "--severity", sev, "--skip-db-update", "--format", "json", "--quiet",
                            "--timeout", "15m", ref], timeout=1200)
        if rc != 0:
            results[ref] = {**info, "error": err.strip()[-300:]}
            continue
        results[ref] = {**info, **summarize_trivy(json.loads(out), cfg["per_image_limit"])}
    return results


def summarize_trivy(report, limit):
    """Keep every CRITICAL and every HIGH that has a fix. Count the rest so nothing is silently dropped."""
    seen, keep = set(), []
    counts = {"critical": 0, "high_fixed": 0, "high_unfixed": 0}
    os_name = (report.get("Metadata") or {}).get("OS") or {}
    for res in report.get("Results") or []:
        for v in res.get("Vulnerabilities") or []:
            key = (v["VulnerabilityID"], v["PkgName"])
            if key in seen:
                continue
            seen.add(key)
            fixed = v.get("FixedVersion") or ""
            if v["Severity"] == "CRITICAL":
                counts["critical"] += 1
            elif fixed:
                counts["high_fixed"] += 1
            else:
                counts["high_unfixed"] += 1
                continue
            keep.append({"id": v["VulnerabilityID"], "sev": v["Severity"][0], "pkg": v["PkgName"],
                         "have": v.get("InstalledVersion", ""), "fix": fixed or "none",
                         "where": res.get("Target", "") if res.get("Class") != "os-pkgs" else "os",
                         "title": (v.get("Title") or "")[:100]})
    keep.sort(key=lambda v: (v["sev"] != "C", v["fix"] == "none"))
    out = {"os": f"{os_name.get('Family', '?')} {os_name.get('Name', '')}".strip(), "counts": counts,
           "findings": keep[:limit]}
    if os_name.get("EOSL"):
        out["os_end_of_life"] = True
    if len(keep) > limit:
        out["truncated"] = len(keep) - limit
    return out


# --- LLM -------------------------------------------------------------------------------------------

def build_prompt(cfg, data):
    parts = [(HERE / "prompt.md").read_text()]
    if cfg["advisory_urls"]:
        parts.append("## Advisory sources for things the scanners don't cover\n" +
                     "\n".join(f"- {k}: {v}" for k, v in cfg["advisory_urls"].items()))
    for f in cfg["context_files"]:
        p = Path(f).expanduser()
        if p.exists():
            parts.append(f"## Context: {p.name} (how this server is set up and what is exposed)\n\n{p.read_text()}")
    parts.append("## Scan data\n\n```json\n" + json.dumps(data, indent=1) + "\n```")
    return "\n\n".join(parts)


def triage(cfg, name, prompt):
    if name not in cfg["providers"]:
        sys.exit(f"phylax: unknown provider {name!r}, have: {', '.join(cfg['providers'])}")
    p = cfg["providers"][name]
    # Start from a clean slate so a leftover ANTHROPIC_BASE_URL can't send a "claude" run to GLM
    env = {k: v for k, v in os.environ.items() if not k.startswith("ANTHROPIC_")}
    env.update({k: str(v) for k, v in p.get("env", {}).items()})
    if p.get("token_file"):
        env["ANTHROPIC_AUTH_TOKEN"] = Path(p["token_file"]).expanduser().read_text().strip()
    tools = p.get("tools", [])
    cmd = [p.get("cli", "claude"), "-p", "--output-format", "text", "--no-session-persistence",
           "--strict-mcp-config", "--permission-mode", "dontAsk", "--tools", ",".join(tools)]
    if tools:
        cmd += ["--allowedTools", ",".join(tools)]
    if p.get("model"):
        cmd += ["--model", p["model"]]
    workdir = STATE / "work"  # empty dir, so no project CLAUDE.md or files around
    workdir.mkdir(parents=True, exist_ok=True)
    log(f"triaging with {name}")
    rc, out, err = run(cmd, timeout=p.get("timeout", 1800), input=prompt, cwd=workdir, env=env)
    if rc != 0:
        return None, f"{name} failed (rc {rc}): {(err or out).strip()[-500:]}"
    return out.strip(), None


def save(text, data, keep):
    STATE.mkdir(parents=True, exist_ok=True)
    stamp = datetime.datetime.now().strftime("%Y-%m-%d_%H%M")
    (STATE / f"{stamp}.md").write_text(text + "\n")
    (STATE / f"{stamp}.json").write_text(json.dumps(data, indent=1) + "\n")
    latest = STATE / "latest.md"
    latest.unlink(missing_ok=True)
    latest.symlink_to(f"{stamp}.md")
    reports = sorted(STATE.glob("*_*.md"))
    for old in reports[:-keep] if keep > 0 else []:
        old.unlink()
        old.with_suffix(".json").unlink(missing_ok=True)
    return STATE / f"{stamp}.md"


def notify(cfg, subject, text):
    if not cfg["notify"]:
        return
    rc, _, err = run(["sh", "-c", cfg["notify"]], input=text, env={**os.environ, "PHYLAX_SUBJECT": subject},
                     timeout=120)
    if rc != 0:
        log(f"notify failed: {err.strip()[:300]}")


def main():
    ap = argparse.ArgumentParser(description="Vulnerability sweep of this host and its containers.")
    ap.add_argument("-p", "--provider", help="provider from the config (default: the config's `provider`)")
    ap.add_argument("--no-llm", action="store_true", help="collect and print the scan data only")
    ap.add_argument("--dry-run", action="store_true", help="print the prompt instead of sending it")
    ap.add_argument("--skip-images", action="store_true", help="don't run trivy (fast, host only)")
    args = ap.parse_args()
    cfg = load_config()

    log("inventory and host scan")
    data = {"date": datetime.date.today().isoformat(), "host": host_inventory(cfg), "arch_audit": arch_audit()}
    images, err = containers()
    data["containers"] = err or ("skipped" if args.skip_images else trivy_scan(images, cfg))

    if args.no_llm:
        print(json.dumps(data, indent=1))
        return
    prompt = build_prompt(cfg, data)
    if args.dry_run:
        print(prompt)
        return

    name = args.provider or cfg["provider"]
    report, err = triage(cfg, name, prompt)
    if err:
        log(err)
        report = f"# phylax {data['date']}\n\nLLM triage failed, raw data saved next to this file.\n\n{err}"
    path = save(report, data, cfg["keep_reports"])
    print(report)
    log(f"saved {path}")
    first = report.splitlines()[0].lstrip("# ").strip() if report else "phylax"
    notify(cfg, first, report)
    if err:
        sys.exit(1)
    # The title is "# phylax <date>: <N> to act on" or ": all clear" (prompt.md). 3 tells sema to ping.
    m = re.search(r":\s*(\d+)\s+to act on", first)
    sys.exit(3 if m and int(m.group(1)) > 0 else 0)


if __name__ == "__main__":
    main()
