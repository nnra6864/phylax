#!/usr/bin/python3 -I
"""phylax: sweep a Linux host and its containers for known vulnerabilities, then let an LLM triage them

Examples:
  phylax                   full sweep: inventory, scanners, LLM triage, saved report
  phylax --no-llm          scanners only, print the collected data (free, no network LLM)
  phylax --dry-run         print the prompt that would be sent, send nothing
  phylax -p glm            use another provider from the config for this run

It figures out what the machine runs: the distro and its package manager, podman and/or docker,
web servers and proxies (angie, nginx, caddy, traefik, apache, haproxy), OpenSSH, listening ports.
Scanners do the finding: trivy for images and for the host's OS packages, arch-audit on Arch
(trivy doesn't cover it). The LLM only reads their output and decides what matters on this machine.
It gets WebFetch/WebSearch and nothing else: no Bash, no Read, so it can't touch any file.

Exit: 0 all clear, 3 something to act on, 1 failed (sema's scan module pings on 3).
Config (optional): ~/.config/phylax/config.toml   Reports: ~/.local/state/phylax/
Standard library only.
"""

import argparse
import datetime
import fcntl
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib
import urllib.parse
import urllib.request
from pathlib import Path

HERE = Path(os.path.realpath(__file__)).parent
CONFIG_PATH = Path(os.environ.get("PHYLAX_CONFIG", "~/.config/phylax/config.toml")).expanduser()
STATE = Path(os.environ.get("XDG_STATE_HOME", "~/.local/state")).expanduser() / "phylax"
UA = "phylax/1"

DEFAULTS = {
    "provider": "claude",
    "providers": {"claude": {"tools": ["WebFetch", "WebSearch"]}},
    "severity": ["HIGH", "CRITICAL"],
    "per_image_limit": 25,
    # Looked up under every package manager; names that don't exist on this distro are left out
    "key_packages": ["openssh", "openssh-server", "openssl", "libssl3", "glibc", "libc6", "sudo", "systemd",
                     "curl", "podman", "docker", "docker-ce", "docker.io", "containerd", "runc", "crun",
                     "netavark", "passt", "libvirt", "qemu-base", "zfs-utils", "fail2ban", "wireguard-tools"],
    "context_files": [],
    "advisory_urls": {},
    "keep_reports": 30,
    "notify": "",
}

# Network-facing software worth a version check: version command, GitHub repo for the latest tag,
# where its security fixes are announced. Only what's installed ends up in the prompt.
SOFTWARE = {
    "angie": (["angie", "-v"], "webserver-llc/angie",
              "https://raw.githubusercontent.com/webserver-llc/angie/master/CHANGES (nginx fork: nginx advisories apply)"),
    "nginx": (["nginx", "-v"], "nginx/nginx", "https://nginx.org/en/security_advisories.html"),
    "caddy": (["caddy", "version"], "caddyserver/caddy", "https://github.com/caddyserver/caddy/security/advisories"),
    "traefik": (["traefik", "version"], "traefik/traefik", "https://github.com/traefik/traefik/security/advisories"),
    "apache": (["apachectl", "-v"], "apache/httpd", "https://httpd.apache.org/security/vulnerabilities_24.html"),
    "haproxy": (["haproxy", "-v"], "haproxy/haproxy", "https://www.haproxy.org/ (news and changelog)"),
    "openssh": (["ssh", "-V"], None, "https://www.openssh.com/security.html"),
}
GENERIC_ADVISORIES = {"cisa_kev": "https://www.cisa.gov/known-exploited-vulnerabilities-catalog"}


def log(*args):
    print("phylax:", *args, file=sys.stderr, flush=True)


def run(cmd, timeout=600, **kw):
    """Run a command, return (returncode, stdout, stderr). A missing binary is rc 127, never an exception."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, **kw)
        return p.returncode, p.stdout, p.stderr
    except FileNotFoundError:
        return 127, "", f"{cmd[0]}: not installed"
    except subprocess.TimeoutExpired:
        return 124, "", f"{cmd[0]}: timed out after {timeout}s"


def load_config():
    cfg = json.loads(json.dumps(DEFAULTS))
    if CONFIG_PATH.exists():
        with open(CONFIG_PATH, "rb") as f:
            user = tomllib.load(f)
        providers = user.pop("providers", {})
        cfg.update(user)
        for name, p in providers.items():
            cfg["providers"].setdefault(name, {}).update(p)
    return cfg


def get_json(url, timeout=20):
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


# --- distro ----------------------------------------------------------------------------------------

def os_release():
    for path in ("/etc/os-release", "/usr/lib/os-release"):
        try:
            with open(path) as f:
                return {k: v.strip().strip('"') for k, _, v in (l.strip().partition("=") for l in f) if k}
        except OSError:
            continue
    return {}


def distro_family(osr):
    ids = {osr.get("ID", "")} | set(osr.get("ID_LIKE", "").split())
    for family in ("arch", "debian", "alpine", "suse", "fedora", "rhel"):
        if family in ids or (family == "suse" and any("suse" in i for i in ids)):
            return "rhel" if family == "fedora" else family
    return "unknown"


def installed_packages(family):
    """{name: version} from the native package manager."""
    cmds = {
        "arch": (["pacman", "-Q"], r"(\S+) (\S+)"),
        "debian": (["dpkg-query", "-W", "-f", "${Package} ${Version}\n"], r"(\S+) (\S+)"),
        "alpine": (["apk", "info", "-v"], r"(.+)-(\d[^-]*-r\d+)"),
        "rhel": (["rpm", "-qa", "--qf", "%{NAME} %{VERSION}-%{RELEASE}\n"], r"(\S+) (\S+)"),
        "suse": (["rpm", "-qa", "--qf", "%{NAME} %{VERSION}-%{RELEASE}\n"], r"(\S+) (\S+)"),
    }
    if family not in cmds:
        return {}
    cmd, pattern = cmds[family]
    _, out, _ = run(cmd)
    return dict(m.groups() for m in map(re.compile(pattern).fullmatch, out.splitlines()) if m)


def pending_updates(family):
    """What the package manager would upgrade. Uses cached metadata, never needs root."""
    if family == "arch":
        rc, out, err = run(["checkupdates"], timeout=180)  # 0 = updates, 2 = none
        ok = rc in (0, 2)
    elif family == "debian":
        rc, out, err = run(["apt", "list", "--upgradable"], timeout=180)
        out = "\n".join(l for l in out.splitlines() if "/" in l)
        ok = rc == 0
        if ok:
            out += "\n(from the cached package lists, which may be stale)" if out else ""
    elif family == "rhel":
        rc, out, err = run(["dnf", "-q", "check-update"], timeout=300)  # 100 = updates, 0 = none
        ok = rc in (0, 100)
    elif family == "suse":
        rc, out, err = run(["zypper", "-q", "list-updates"], timeout=300)
        ok = rc == 0
    elif family == "alpine":
        rc, out, err = run(["apk", "version", "-l", "<"], timeout=180)
        ok = rc == 0
    else:
        return "unknown package manager"
    if not ok:
        return f"update check failed: {(err or out).strip()[:200]}"
    return [l for l in out.splitlines() if l.strip() and not l.startswith("Installed:")]


def aur_compare(foreign):
    """Arch: installed vs AUR version for foreign packages, which no tracker covers."""
    result = {n: {"installed": v} for n, v in foreign.items()}
    if not foreign:
        return result
    try:
        qs = "&".join("arg[]=" + urllib.parse.quote(n) for n in foreign)
        for r in get_json("https://aur.archlinux.org/rpc/v5/info?" + qs)["results"]:
            entry = result[r["Name"]]
            entry["aur"] = r["Version"]
            if not r["Name"].endswith("-git"):  # VCS versions don't compare meaningfully
                _, cmp, _ = run(["vercmp", entry["installed"], r["Version"]])
                entry["outdated"] = cmp.strip().startswith("-")
    except Exception as e:
        log(f"AUR lookup failed: {e}")
    return result


def host_vulns(family, cfg):
    """Known CVEs in the host's OS packages."""
    if family == "arch":
        rc, out, err = run(["arch-audit", "-c"], timeout=180)
        if rc == 127:
            return "arch-audit is not installed"
        if rc != 0 and not out:
            return f"arch-audit failed: {err.strip()[:300]}"
        return {"source": "arch-audit (Arch security tracker)", "result": out.strip() or "no affected packages"}
    if not shutil.which("trivy"):
        return "trivy is not installed"
    # trivy reads only the package database, so give it a tiny root with just that instead of all of /
    with tempfile.TemporaryDirectory(prefix="phylax-root-") as root:
        patterns = ["etc/os-release", "usr/lib/os-release", "etc/*-release", "var/lib/dpkg/status",
                    "var/lib/dpkg/status.d/*", "lib/apk/db/installed", "var/lib/rpm/*", "usr/lib/sysimage/rpm/*"]
        for pat in patterns:
            for src in glob.glob("/" + pat):
                if os.path.isfile(src):
                    dst = Path(root) / src.lstrip("/")
                    dst.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(src, dst)
        rc, out, err = run(["trivy", "rootfs", "--scanners", "vuln", "--pkg-types", "os", "--skip-db-update",
                            "--severity", ",".join(cfg["severity"]), "--format", "json", "--quiet", root],
                           timeout=900)
    if rc != 0:
        return f"trivy rootfs failed: {err.strip()[-300:]}"
    return {"source": "trivy (OS packages)", **summarize_trivy(json.loads(out), 60)}


# --- software and exposure -------------------------------------------------------------------------

def network_software():
    """Installed web servers, proxies and sshd with their versions and the latest upstream tag."""
    found, seen_outputs = {}, set()
    for name, (cmd, repo, advisories) in SOFTWARE.items():
        if name == "apache" and not shutil.which("apachectl"):
            cmd = ["httpd", "-v"]
        rc, out, err = run(cmd, timeout=20)
        text = (out + err).strip().splitlines()[0] if (out + err).strip() else ""
        if rc == 127 or not text or text in seen_outputs:  # e.g. nginx being an alias for angie
            continue
        seen_outputs.add(text)
        entry = {"version": text, "advisories": advisories}
        if repo:
            entry["latest_upstream_tag"] = github_latest_tag(repo)
        found[name] = entry
    return found


def github_latest_tag(repo):
    try:
        tags = [t["name"] for t in get_json(f"https://api.github.com/repos/{repo}/tags?per_page=10")]
        stable = [t for t in tags if not re.search(r"(rc|beta|alpha|pre)", t, re.I)]
        return (stable or tags)[0]
    except Exception as e:
        return f"lookup failed: {e}"


def running_services():
    rc, out, _ = run(["systemctl", "list-units", "--type=service", "--state=running", "--no-legend", "--plain"])
    if rc != 0:
        return "systemctl unavailable"
    return [line.split()[0].removesuffix(".service") for line in out.splitlines() if line.strip()]


def listening_sockets():
    _, out, _ = run(["ss", "-tulnH"])
    found = set()
    for line in out.splitlines():
        parts = line.split()
        if len(parts) >= 5:
            found.add(f"{parts[0]} {parts[4]}")
    return sorted(found)


# --- containers ------------------------------------------------------------------------------------

def container_runtimes():
    runtimes = []
    if shutil.which("podman"):
        runtimes.append("podman")
    if shutil.which("docker"):
        _, out, err = run(["docker", "--version"], timeout=20)
        if "podman" not in (out + err).lower():  # podman-docker is just an alias
            runtimes.append("docker")
    return runtimes


def containers(runtime):
    """Running containers grouped by image: names, published ports, compose dir. Never env or full inspect."""
    rc, out, err = run([runtime, "ps", "--format", "json"])
    if rc != 0:
        return None, f"{runtime} ps failed: {err.strip()[:300]}"
    out = out.strip()
    # podman prints one JSON array, docker one object per line
    rows = json.loads(out) if out.startswith("[") else [json.loads(l) for l in out.splitlines() if l.strip()]
    images = {}
    for c in rows:
        ref = c["Image"]
        img = images.setdefault(ref, {"runtime": runtime, "containers": [], "ports": set(), "compose_dirs": set()})
        names = c.get("Names", [])
        img["containers"] += [names] if isinstance(names, str) else names
        labels = c.get("Labels") or {}
        if isinstance(labels, str):  # docker: "k=v,k=v"
            labels = dict(kv.partition("=")[::2] for kv in labels.split(",") if "=" in kv)
        if labels.get("com.docker.compose.project.working_dir"):
            img["compose_dirs"].add(labels["com.docker.compose.project.working_dir"])
        ports = c.get("Ports") or []
        if isinstance(ports, str):
            img["ports"].update(p.strip() for p in ports.split(",") if p.strip())
        else:
            for p in ports:
                if p.get("host_port"):
                    img["ports"].add(f"{p.get('host_ip') or '0.0.0.0'}:{p['host_port']}->{p['container_port']}/"
                                     f"{p.get('protocol', 'tcp')}")
    for img in images.values():
        img["ports"] = sorted(img["ports"])
        img["compose_dirs"] = sorted(img["compose_dirs"])
    for ref, img in images.items():  # one at a time: a single missing image would shift a batched list
        rc, out, _ = run([runtime, "image", "inspect", "--format", "{{.Created}}", ref], timeout=30)
        if rc == 0 and out.strip():
            img["created"] = out.strip()[:10]
    return images, None


def trivy_images(images, cfg):
    results = {}
    for n, (ref, info) in enumerate(images.items(), 1):
        log(f"[{n}/{len(images)}] trivy {ref}")
        # --scanners vuln: no secret scanning, so nothing secret from an image can end up in the prompt
        rc, out, err = run(["trivy", "image", "--image-src", info["runtime"], "--scanners", "vuln",
                            "--severity", ",".join(cfg["severity"]), "--skip-db-update", "--format", "json",
                            "--quiet", "--timeout", "15m", ref], timeout=1200)
        if rc != 0:
            results[ref] = {**info, "error": err.strip()[-300:]}
        else:
            results[ref] = {**info, **summarize_trivy(json.loads(out), cfg["per_image_limit"])}
    return results


def summarize_trivy(report, limit):
    """Keep every CRITICAL and every HIGH that has a fix. Count the rest so nothing is silently dropped."""
    seen, keep = set(), []
    counts = {"critical": 0, "high_fixed": 0, "high_unfixed": 0}
    os_info = (report.get("Metadata") or {}).get("OS") or {}
    for res in report.get("Results") or []:
        for v in res.get("Vulnerabilities") or []:
            key = (v["VulnerabilityID"], v["PkgName"])
            if key in seen:
                continue
            seen.add(key)
            fixed = v.get("FixedVersion") or ""
            if v["Severity"] == "CRITICAL":
                counts["critical"] += 1
            elif fixed:
                counts["high_fixed"] += 1
            else:
                counts["high_unfixed"] += 1
                continue
            keep.append({"id": v["VulnerabilityID"], "sev": v["Severity"][0], "pkg": v["PkgName"],
                         "have": v.get("InstalledVersion", ""), "fix": fixed or "none",
                         "where": "os" if res.get("Class") == "os-pkgs" else res.get("Target", ""),
                         "title": (v.get("Title") or "")[:100]})
    keep.sort(key=lambda v: (v["sev"] != "C", v["fix"] == "none"))
    out = {"os": f"{os_info.get('Family', '?')} {os_info.get('Name', '')}".strip(), "counts": counts,
           "findings": keep[:limit]}
    if os_info.get("EOSL"):
        out["os_end_of_life"] = True
    if len(keep) > limit:
        out["truncated"] = len(keep) - limit
    return out


# --- collect ---------------------------------------------------------------------------------------

def collect(cfg, skip_images):
    osr = os_release()
    family = distro_family(osr)
    log(f"host: {osr.get('PRETTY_NAME', '?')} ({family})")
    trivy_ok = shutil.which("trivy") and update_trivy_db()

    pkgs = installed_packages(family)
    host = {
        "os": osr.get("PRETTY_NAME", "unknown"), "family": family, "kernel": os.uname().release,
        "package_count": len(pkgs),
        "key_packages": {n: pkgs[n] for n in cfg["key_packages"] if n in pkgs},
        "kernel_packages": {n: v for n, v in pkgs.items()
                            if re.fullmatch(r"(linux|kernel)(-image)?(-[\w.]+)*", n)
                            and not re.search(r"headers|firmware|api|tools|devel|doc", n)},
        "pending_updates": pending_updates(family),
        "network_software": network_software(),
        "running_services": running_services(),
        "listening_sockets": listening_sockets(),
    }
    if family == "arch":
        _, out, _ = run(["pacman", "-Qm"])
        host["aur_packages"] = aur_compare(dict(l.split()[:2] for l in out.splitlines() if l.strip()))
    data = {"date": datetime.date.today().isoformat(), "host": host,
            "host_vulns": host_vulns(family, cfg) if trivy_ok or family == "arch" else "trivy is not installed"}

    data["containers"] = {}
    for rt in container_runtimes():
        images, err = containers(rt)
        if err:
            data["containers"][rt] = err
        elif skip_images:
            data["containers"][rt] = {ref: {**i, "scan": "skipped"} for ref, i in images.items()}
        elif not trivy_ok:
            data["containers"][rt] = {ref: {**i, "scan": "trivy not available"} for ref, i in images.items()}
        else:
            data["containers"][rt] = trivy_images(images, cfg)
    if not data["containers"]:
        data["containers"] = "no container runtime found"
    return data


def update_trivy_db():
    log("updating the trivy vulnerability database")
    rc, _, err = run(["trivy", "image", "--download-db-only", "--quiet"], timeout=900)
    if rc != 0:
        log(f"trivy db update failed: {err.strip()[:300]}")
    return rc == 0


# --- LLM -------------------------------------------------------------------------------------------

def build_prompt(cfg, data):
    parts = [(HERE / "prompt.md").read_text()]
    urls = {name: s["advisories"] for name, s in data["host"]["network_software"].items()}
    urls.update(GENERIC_ADVISORIES)
    urls.update(cfg["advisory_urls"])
    parts.append("## Advisory sources\n" + "\n".join(f"- {k}: {v}" for k, v in urls.items()))
    for f in cfg["context_files"]:
        p = Path(f).expanduser()
        if p.exists():
            parts.append(f"## Context from the owner: {p.name}\n\n{p.read_text()}")
        else:
            log(f"context file {p} doesn't exist, skipping it")
    parts.append("## Scan data\n\n```json\n" + json.dumps(data, indent=1) + "\n```")
    return "\n\n".join(parts)


def triage(cfg, name, prompt):
    if name not in cfg["providers"]:
        sys.exit(f"phylax: unknown provider {name!r}, have: {', '.join(cfg['providers'])}")
    p = cfg["providers"][name]
    # Start from a clean slate so a leftover ANTHROPIC_BASE_URL can't send a "claude" run elsewhere
    env = {k: v for k, v in os.environ.items() if not k.startswith("ANTHROPIC_")}
    env.update({k: str(v) for k, v in p.get("env", {}).items()})
    if p.get("token_file"):
        env["ANTHROPIC_AUTH_TOKEN"] = Path(p["token_file"]).expanduser().read_text().strip()
    tools = p.get("tools", [])
    cmd = [p.get("cli", "claude"), "-p", "--output-format", "text", "--no-session-persistence",
           "--strict-mcp-config", "--permission-mode", "dontAsk", "--tools", ",".join(tools)]
    if tools:
        cmd += ["--allowedTools", ",".join(tools)]
    if p.get("model"):
        cmd += ["--model", p["model"]]
    workdir = STATE / "work"  # empty dir, so no project CLAUDE.md or files around
    workdir.mkdir(parents=True, exist_ok=True)
    log(f"triaging with {name}")
    rc, out, err = run(cmd, timeout=p.get("timeout", 1800), input=prompt, cwd=workdir, env=env)
    if rc != 0:
        return None, f"{name} failed (rc {rc}): {(err or out).strip()[-500:]}"
    return out.strip(), None


def save(text, data, keep):
    STATE.mkdir(parents=True, exist_ok=True)
    stamp = datetime.datetime.now().strftime("%Y-%m-%d_%H%M")
    (STATE / f"{stamp}.md").write_text(text + "\n")
    (STATE / f"{stamp}.json").write_text(json.dumps(data, indent=1) + "\n")
    latest = STATE / "latest.md"
    latest.unlink(missing_ok=True)
    latest.symlink_to(f"{stamp}.md")
    reports = sorted(STATE.glob("*_*.md"))
    for old in reports[:-keep] if keep > 0 else []:
        old.unlink()
        old.with_suffix(".json").unlink(missing_ok=True)
    return STATE / f"{stamp}.md"


def notify(cfg, subject, text):
    if not cfg["notify"]:
        return
    rc, _, err = run(["sh", "-c", cfg["notify"]], input=text, env={**os.environ, "PHYLAX_SUBJECT": subject},
                     timeout=120)
    if rc != 0:
        log(f"notify failed: {err.strip()[:300]}")


def main():
    ap = argparse.ArgumentParser(description="Vulnerability sweep of this host and its containers.")
    ap.add_argument("-p", "--provider", help="provider from the config (default: the config's `provider`)")
    ap.add_argument("--no-llm", action="store_true", help="collect and print the scan data only")
    ap.add_argument("--dry-run", action="store_true", help="print the prompt instead of sending it")
    ap.add_argument("--skip-images", action="store_true", help="don't scan container images (fast)")
    args = ap.parse_args()
    cfg = load_config()

    # trivy's cache allows one process at a time, so two overlapping runs would both lose scans
    STATE.mkdir(parents=True, exist_ok=True)
    lock = open(STATE / "run.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        log("another phylax run is in progress, waiting for it to finish")
        fcntl.flock(lock, fcntl.LOCK_EX)

    data = collect(cfg, args.skip_images)
    if args.no_llm:
        print(json.dumps(data, indent=1))
        return
    prompt = build_prompt(cfg, data)
    if args.dry_run:
        print(prompt)
        return

    report, err = triage(cfg, args.provider or cfg["provider"], prompt)
    if err:
        log(err)
        report = f"# phylax {data['date']}: triage failed\n\nRaw scan data is saved next to this report.\n\n{err}"
    path = save(report, data, cfg["keep_reports"])
    print(report)
    log(f"saved {path}")
    first = report.splitlines()[0].lstrip("# ").strip()
    notify(cfg, first, report)
    if err:
        sys.exit(1)
    # The title is "# phylax <date>: <N> to act on" or ": all clear" (prompt.md). 3 tells sema to ping.
    m = re.search(r":\s*(\d+)\s+to act on", first)
    sys.exit(3 if m and int(m.group(1)) > 0 else 0)


if __name__ == "__main__":
    main()
